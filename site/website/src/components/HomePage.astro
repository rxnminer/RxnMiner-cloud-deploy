---
import SiteLayout from '../layouts/SiteLayout.astro';
import { assetPath, repositoryUrl, type SiteLocale } from '../data/site';
import benchmark from '../data/benchmark.json';
import { modelLogo } from '../data/modelLogo';
interface Props { locale: SiteLocale }
const { locale } = Astro.props;
const rows = benchmark.cohorts[0].rows.filter(row => !row.pending)
  .sort((a, b) => (b.iso.reaction_f1 ?? -1) - (a.iso.reaction_f1 ?? -1)).slice(0, 5);
---
<SiteLayout locale={locale} active="home" title="Chemical literature, ready for discovery" description="RxnMiner turns reaction figures into structured, reviewable chemistry.">
  <div class="page-shell">
    <section class="benchmark-glance" aria-label="Benchmark scores">
      <div class="glance-label"><span>CHEMRXN-BENCH</span><span>Top 5 · Reaction F1 · strict stereo · 603 figures</span><a href={assetPath('/benchmark/')}>Full results ↗</a></div>
      <div class="glance-scores">{rows.map(row => <div class:list={['glance-score', {ours: row.group === 'RxnMiner'}]}><span class="glance-model">{modelLogo(row.lane) && <img src={assetPath(`/assets/model-logos/${modelLogo(row.lane)}.svg`)} alt="" width="20" height="20"/>}{row.name}</span><strong>{(100 * (row.iso.reaction_f1 ?? 0)).toFixed(2)}<small>%</small></strong></div>)}</div>
    </section>
    <section class="rxn-hero">
      <div>
        <p class="eyebrow">RXNMINER / A CHEMISTRY EXTRACTION AGENT</p>
        <h1>From chemical literature<br/><span>to usable reactions.</span></h1>
        <p class="rxn-lede">Read reaction figures and schemes. Recover the chemistry, trace the evidence, and review every reaction.</p>
        <div class="hero__actions"><a class="button" href={assetPath('/try/')}>Try a figure <span aria-hidden="true">↗</span></a><a class="button button--quiet" href={assetPath('/demos/')}>Watch the demo <span aria-hidden="true">→</span></a></div>
        <p class="rxn-inputs">REACTION SCHEMES <span> / </span> SCOPE FIGURES <span> / </span> TABLES</p>
      </div>
      <a class="rxn-preview" href={assetPath('/demos/')} aria-label="Watch the workspace demo">
        <div class="preview-title"><span class="status-dot"></span>SOURCE → STRUCTURE → REVIEW<span>WATCH DEMO</span></div>
        <img src={assetPath('/media/rxnminer-visual-demo-poster.jpg')} width="1600" height="950" alt="Reaction extraction workspace showing the source figure, molecule boxes, and structured reactions"/>
        <div class="preview-caption"><span>Source evidence, structures, and visual review</span><span class="play-icon" aria-hidden="true">▶</span></div>
      </a>
    </section>
    <div class="research-strip" aria-label="ChemRxn-Bench at a glance"><a href={assetPath('/benchmark/')}><strong>603</strong><span>chemistry figures</span></a><a href={assetPath('/benchmark/')}><strong>8,547</strong><span>reference reactions</span></a><a href={assetPath('/benchmark/')}><strong>5</strong><span>figure layouts</span></a><a href={assetPath('/benchmark/')} class="strip-link">ChemRxn-Bench <span aria-hidden="true">↗</span></a></div>
    <section class="rxn-start"><div><p class="eyebrow">ON YOUR OWN MACHINE</p><h2>Start with a reproducible demo.</h2><p>Explore the visual workspace, then connect your model and UniParser API key to extract your own reaction images.</p><a class="text-link" href={repositoryUrl}>GitHub →</a></div><div class="install-box"><div class="install-label">LOCAL DEMO · NO MODEL CALLS</div><pre><code>npm ci
node ./rxnminer.mjs setup
node ./rxnminer.mjs demo demo-figure</code></pre><a href={repositoryUrl}>Setup and source code →</a></div></section>
  </div>
</SiteLayout>
<style>
.rxn-hero{display:grid;grid-template-columns:1fr 1.08fr;gap:4%;align-items:center;padding:38px 0 44px}.rxn-hero h1{font-family:var(--serif);font-size:clamp(2.7rem,4.2vw,4.3rem);line-height:1.08;letter-spacing:-.045em;margin:22px 0}.rxn-hero h1 span{color:#5579a5}.rxn-lede{font-size:1.12rem;line-height:1.8;color:var(--muted);max-width:500px}.rxn-inputs{font-family:var(--mono);font-size:.73rem;letter-spacing:.13em;margin-top:28px;color:var(--muted)}.rxn-inputs span{padding:0 12px;color:#b4aad3}.rxn-preview{display:block;background:#fff;border:1px solid #c7d3e4;border-radius:10px;text-decoration:none;overflow:hidden;box-shadow:0 22px 65px #29333b12;transform:rotate(-1deg)}.rxn-preview:hover{transform:rotate(0)}.preview-title,.preview-caption{display:flex;align-items:center;gap:9px;padding:15px 18px;font-family:var(--mono);font-size:.65rem;letter-spacing:.04em;background:#f4f7fb}.preview-title>span:last-child{margin-left:auto;color:#718499}.rxn-preview img{width:100%;aspect-ratio:1.5;object-fit:cover;object-position:top}.preview-caption{border-top:1px solid var(--line);font-family:var(--sans);font-size:.75rem;justify-content:space-between}.status-dot{width:6px;height:6px;background:#7097c5;border-radius:50%}.play-icon{border:1px solid #b4aad3;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;color:#627cad}.research-strip{display:grid;grid-template-columns:repeat(3,1fr) 1.1fr;border-top:1px solid #bfcddd;border-bottom:1px solid #bfcddd}.research-strip a{padding:26px 30px;text-decoration:none;border-right:1px solid var(--line);display:flex;gap:15px;align-items:center}.research-strip a:first-child{padding-left:0}.research-strip strong{font-family:var(--serif);font-size:2.15rem;font-weight:500}.research-strip span{font-size:.78rem;color:var(--muted);max-width:95px;line-height:1.5}.research-strip .strip-link{justify-content:space-between;border:0;color:#426da1;font-size:.85rem}.rxn-benchmark{display:grid;grid-template-columns:1fr 1fr;gap:9%;padding:50px;margin-top:70px;background:#edf3f9;border:1px solid #dce3ed;border-radius:8px}.rxn-benchmark h2,.rxn-start h2{font-family:var(--serif);font-weight:500;font-size:clamp(2rem,3vw,3rem);line-height:1.2;letter-spacing:-.025em;margin:13px 0 22px}.rxn-benchmark p,.rxn-start p{color:var(--muted);font-size:.95rem;line-height:1.85}.text-link{display:inline-block;margin-top:12px;text-decoration:none;color:#315780;font-weight:600}.score-row{margin-bottom:19px}.score-row>div:first-child{display:flex;justify-content:space-between;gap:15px;font-size:.78rem;margin-bottom:8px}.score-row>div:first-child>span{display:flex;align-items:center;gap:8px;min-width:0}.score-row strong{font-variant-numeric:tabular-nums;font-weight:600}.score-row small{font-weight:400;margin-left:3px}.bar-track{height:7px;background:#dce5f0;border-radius:2px;overflow:hidden}.bar-track>span{height:100%;background:#b4aad3;display:block}.ours .bar-track>span{background:#7097c5}.ours>div:first-child{color:#315780}.score-note{font-size:.7rem!important;line-height:1.5!important;margin:24px 0 0}.rxn-start{display:grid;grid-template-columns:1fr 1fr;gap:9%;padding:85px 0;align-items:center}.install-box{border:1px solid #d2dce8;background:#fff;border-radius:8px;overflow:hidden}.install-label{padding:16px 22px;background:#f2eff8;color:#696080;font:.7rem var(--mono);letter-spacing:.04em}.install-box pre{margin:0;padding:24px;font-size:.87rem;line-height:2;overflow:auto}.install-box>a{display:block;padding:14px 24px;border-top:1px solid var(--line);font-size:.75rem;text-decoration:none;color:#426da1}@media(max-width:1000px){.rxn-hero{grid-template-columns:1fr;padding-top:48px;gap:34px}.rxn-preview{max-width:720px;transform:none}.research-strip a{padding:18px 12px;gap:9px}.research-strip strong{font-size:1.75rem}.rxn-benchmark{gap:5%;padding:30px}.rxn-start{gap:5%}}@media(max-width:650px){.rxn-hero h1{font-size:2.75rem}.research-strip{grid-template-columns:repeat(2,1fr)}.research-strip a:first-child{padding-left:12px}.rxn-features,.rxn-benchmark,.rxn-start{grid-template-columns:1fr}.rxn-benchmark{gap:30px;padding:25px}.rxn-start{gap:20px;padding:55px 0}}
.rxn-benchmark--top{margin-top:34px;margin-bottom:20px}
</style>


<style>
.benchmark-glance{margin-top:24px;border:1px solid var(--line);border-radius:8px;background:var(--surface);overflow:hidden}
.glance-label{display:flex;gap:18px;align-items:center;padding:12px 18px;background:var(--paper-soft);font-size:.7rem;color:var(--muted)}
.glance-label>span:first-child{font-family:var(--mono);color:var(--accent-dark);letter-spacing:.07em}.glance-label a{margin-left:auto;color:var(--accent-dark);white-space:nowrap}
.glance-model{display:flex;align-items:center;gap:7px}.glance-model img{flex:none;width:20px;height:20px;object-fit:contain}
.glance-scores{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}.glance-score{padding:15px 18px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.glance-score:last-child{border:0}.glance-score>span{font-size:.72rem;line-height:1.4}.glance-score strong{font-size:1.8rem;letter-spacing:-.04em;font-variant-numeric:tabular-nums;font-weight:600}.glance-score small{font-size:.75rem;margin-left:3px}.glance-score.ours{background:#edf3f9;color:#315780}
@media(max-width:650px){.benchmark-glance{margin-top:16px}.glance-label{flex-wrap:wrap;gap:6px 12px;padding:10px 12px}.glance-label>span:nth-child(2){order:3;width:100%}.glance-scores{grid-template-columns:repeat(2,minmax(0,1fr))}.glance-score{padding:10px 12px;gap:3px;border-bottom:1px solid var(--line)}.glance-score.ours{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center}.glance-score strong{font-size:1.45rem}.rxn-hero{padding-top:28px}}
</style>
