{
  "name": "@chemrxn/pi-runtime-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "verify:parity": "npm run build && node --test --test-concurrency=1 dist/test/protocol-fingerprint.test.js dist/test/tool-contract-parity.test.js dist/test/import-replay-parity.test.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "typebox": "1.1.38",
    "undici": "8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
